{
  "name": "@theclawlab/theclaw",
  "version": "1.0.9",
  "description": "TheClaw setup and config CLI command",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "theclaw": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:manual": "vitest run --config vitest.manual.config.ts",
    "test:watch": "vitest",
    "typecheck": "npx tsc --noEmit",
    "release:local": "npm run build && npm link",
    "release:public": "npm test && npm run build && npm publish --access public",
    "release:public:skip-test": "npm run build && npm publish --access public"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^12.0.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.8.0",
    "fast-check": "^3.22.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
